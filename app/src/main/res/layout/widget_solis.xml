<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- 1. CAPSULE PILL BACKGROUND -->
    <ImageView
        android:id="@+id/solis_pill_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="18dp"
        android:scaleType="fitXY" />

    <!-- 2. CUSTOM TEXT AREA (BRICK SANS) -->
    <ImageView
        android:id="@+id/solis_custom_text_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="76dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart" />

    <!-- 3. OVERLAPPING HEXAGON BADGE -->
    <ImageView
        android:id="@+id/solis_hex_bg_img"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="fitCenter" />

    <!-- 4. REAL-TIME HARDWARE ANALOG CLOCK (LTC ENGINE) -->
    <AnalogClock
        android:id="@+id/solis_analog_clock"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:hand_hour="@drawable/solis_hand_hour"
        android:hand_minute="@drawable/solis_hand_minute"
        android:hand_second="@drawable/solis_hand_second" />

</RelativeLayout>
