<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- 1. SLIM CAPSULE PILL: Height reduced to 34dp (1/2 original height) -->
    <ImageView
        android:id="@+id/solis_pill_bg_img"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="32dp"
        android:scaleType="fitXY" />

    <!-- 2. CUSTOM TEXT: Scaled & centered inside the slim pill -->
    <ImageView
        android:id="@+id/solis_custom_text_img"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="80dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart" />

    <!-- 3. OVERLAPPING DOCK WITH SHADOW (NO STATIC DRAWABLE OVERRIDE) -->
    <ImageView
        android:id="@+id/solis_hex_bg_img"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="fitCenter" />

    <!-- 4. LTC HARDWARE CLOCK: Expanded bounds to show 2x extended hands -->
    <AnalogClock
        android:id="@+id/solis_analog_clock"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:hand_hour="@drawable/solis_hand_hour"
        android:hand_minute="@drawable/solis_hand_minute"
        android:hand_second="@drawable/solis_hand_second" />

</RelativeLayout>
