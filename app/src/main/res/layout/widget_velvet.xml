<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:padding="8dp">

    <!-- VERTICALLY & HORIZONTALLY CENTERED CLOCK CLUSTER -->
    <LinearLayout
        android:id="@+id/velvet_center_cluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- LAYERED TIME CLUSTER -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- 1. GHOST TIME (TALL BEBAS NEUE FONT, ZERO-DELAY, ADAPTS TO WALLPAPER) -->
            <TextClock
                android:id="@+id/velvet_time_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:format12Hour="h:mm"
                android:format24Hour="kk:mm"
                android:textColor="?android:attr/textColorPrimary"
                android:alpha="0.22"
                android:textSize="110sp"
                android:fontFamily="@font/clock_digits"
                android:includeFontPadding="false" />

            <!-- 2. AM/PM INDICATOR (PINNED TO THE RIGHT OF NUMBERS, ADAPTS TO WALLPAPER) -->
            <TextClock
                android:id="@+id/velvet_ampm_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/velvet_time_clock"
                android:layout_alignBottom="@id/velvet_time_clock"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="20dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="?android:attr/textColorPrimary"
                android:alpha="0.45"
                android:textSize="13sp"
                android:fontFamily="@font/sans_meta"
                android:includeFontPadding="false" />

            <!-- 3. SCRIPT DAY OVERLAY (PERMANENT LAVENDER #B84DFF) -->
            <ImageView
                android:id="@+id/velvet_day_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

        </RelativeLayout>

        <!-- 4. CENTERED DIVIDER LINE (ADAPTS TO WALLPAPER) -->
        <ImageView
            android:id="@+id/velvet_divider_img"
            android:layout_width="48dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="?android:attr/textColorPrimary"
            android:alpha="0.35" />

        <!-- 5. DATE (ADAPTS TO WALLPAPER, ALL-CAPS SANS-META) -->
        <TextClock
            android:id="@+id/velvet_date_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d MMMM yyyy"
            android:format24Hour="d MMMM yyyy"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:fontFamily="@font/sans_meta"
            android:letterSpacing="0.18" />

    </LinearLayout>

</RelativeLayout>
